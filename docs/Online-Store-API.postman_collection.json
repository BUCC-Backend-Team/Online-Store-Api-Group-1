{
  "info": {
    "name": "Online Store API",
    "description": "Complete REST API for the Online Store: auth (JWT access + refresh cookie), users, products (Redis-cached), cart, and orders with stock management.\n\n## Quick start\n1. Run `npm run dev`\n2. Import this collection into Postman\n3. Call **Auth → Signup** or **Auth → Login** — the access token is saved automatically\n4. All subsequent requests use the saved token from the `accessToken` environment variable\n\n## Environments\n- Local dev: `http://localhost:3000/api`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "change_me_from_env" },
    { "key": "userEmail", "value": "jane@example.com" },
    { "key": "userPassword", "value": "Password123" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Public probe of Database + Redis. `200` ok (or degraded when only Redis is down), `503` when the database is unreachable."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.test('201 created with tokens', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(json.status).to.eql('success');",
                  "  pm.expect(json.accessToken).to.be.a('string');",
                  "  pm.expect(json.user.passwordHash).to.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"Password123\",\n  \"passwordConfirm\": \"Password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/signup", "host": ["{{baseUrl}}"], "path": ["auth", "signup"] },
            "description": "Creates a `user` account. Returns **201** with the public user, an access token (15 min) in the body, and an httpOnly `refresh_token` cookie (7 days). The token is saved to the collection automatically.\n\nErrors: `400` validation (`details[]`), `409` email in use."
          }
        },
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.test('200 with admin token', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(json.user.role).to.eql('admin');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Admin credentials come from `ADMIN_EMAIL` / `ADMIN_PASSWORD` in the server env — admins never sign up. Set `adminPassword` in the collection variables to the value from your `.env`."
          }
        },
        {
          "name": "Login (user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.test('200 with user token', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.test('200 rotated refresh token', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] },
            "description": "Uses the httpOnly `refresh_token` cookie (Postman stores cookies automatically per domain). The old token is **revoked** in Redis and a new one is issued — replaying the same cookie returns `401`."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] },
            "description": "Revokes the refresh token in Redis and clears the cookie."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get my profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          }
        },
        {
          "name": "Update my profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Jane D.\"\n}" },
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          }
        },
        {
          "name": "List all users (admin)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          }
        },
        {
          "name": "Get user by id (admin)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users/:id", "host": ["{{baseUrl}}"], "path": ["users", ":id"], "variable": [{ "key": "id", "value": "22222222-2222-4222-8222-222222222222" }] }
          }
        },
        {
          "name": "Delete user (admin)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/users/:id", "host": ["{{baseUrl}}"], "path": ["users", ":id"], "variable": [{ "key": "id", "value": "22222222-2222-4222-8222-222222222222" }] },
            "description": "Also revokes all of that user's refresh tokens in Redis."
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products (public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/product?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["product"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20", "description": "1–100, default 20" }
              ]
            },
            "description": "Public and Redis-cached (5 min TTL). Any admin write invalidates the cache instantly."
          }
        },
        {
          "name": "Get product (public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/product/:id", "host": ["{{baseUrl}}"], "path": ["product", ":id"], "variable": [{ "key": "id", "value": "33333333-3333-4333-8333-333333333333" }] }
          }
        },
        {
          "name": "Create product (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Mechanical Keyboard\",\n  \"description\": \"Hot-swappable, RGB\",\n  \"price\": 79.99,\n  \"stock\": 25\n}" },
            "url": { "raw": "{{baseUrl}}/product", "host": ["{{baseUrl}}"], "path": ["product"] }
          }
        },
        {
          "name": "Update product (admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"stock\": 3\n}" },
            "url": { "raw": "{{baseUrl}}/product/:id", "host": ["{{baseUrl}}"], "path": ["product", ":id"], "variable": [{ "key": "id", "value": "33333333-3333-4333-8333-333333333333" }] }
          }
        },
        {
          "name": "Delete product (admin)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/product/:id", "host": ["{{baseUrl}}"], "path": ["product", ":id"], "variable": [{ "key": "id", "value": "33333333-3333-4333-8333-333333333333" }] }
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Get my cart",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/cart", "host": ["{{baseUrl}}"], "path": ["cart"] },
            "description": "Shows **live** catalog prices — prices are only fixed when an order is placed."
          }
        },
        {
          "name": "Add item",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"productId\": \"33333333-3333-4333-8333-333333333333\",\n  \"quantity\": 2\n}" },
            "url": { "raw": "{{baseUrl}}/cart", "host": ["{{baseUrl}}"], "path": ["cart"] },
            "description": "Merges quantity when the product is already in the cart. `400` when quantity exceeds available stock."
          }
        },
        {
          "name": "Update item quantity",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 5\n}" },
            "url": { "raw": "{{baseUrl}}/cart/:itemId", "host": ["{{baseUrl}}"], "path": ["cart", ":itemId"], "variable": [{ "key": "itemId", "value": "44444444-4444-4444-8444-444444444444" }] }
          }
        },
        {
          "name": "Remove item",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/cart/:itemId", "host": ["{{baseUrl}}"], "path": ["cart", ":itemId"], "variable": [{ "key": "itemId", "value": "44444444-4444-4444-8444-444444444444" }] }
          }
        },
        {
          "name": "Clear cart",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/cart", "host": ["{{baseUrl}}"], "path": ["cart"] }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Place order from cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.order) pm.collectionVariables.set('orderId', json.order.id);",
                  "pm.test('201 pending order with snapshots', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(json.order.status).to.eql('pending');",
                  "  pm.expect(json.order.items[0].unitPrice).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] },
            "description": "Requires a non-empty cart. Runs in one transaction: locks product rows, validates stock, **snapshots prices**, decrements stock, clears the cart. Order starts `pending`."
          }
        },
        {
          "name": "List my orders",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }]
            },
            "description": "Customers see their own orders; admins see every order."
          }
        },
        {
          "name": "Get order by id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/orders/:id", "host": ["{{baseUrl}}"], "path": ["orders", ":id"], "variable": [{ "key": "id", "value": "{{orderId}}" }] },
            "description": "Customers can only read their own orders (`404` otherwise)."
          }
        },
        {
          "name": "Complete order (pay)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/orders/:id/completed", "host": ["{{baseUrl}}"], "path": ["orders", ":id", "completed"], "variable": [{ "key": "id", "value": "{{orderId}}" }] },
            "description": "Demo payment: `pending → paid` (owner only)."
          }
        },
        {
          "name": "Cancel order",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/orders/:id/cancel", "host": ["{{baseUrl}}"], "path": ["orders", ":id", "cancel"], "variable": [{ "key": "id", "value": "{{orderId}}" }] },
            "description": "Owner or admin. Allowed from `pending` or `paid`; **restores product stock** atomically."
          }
        },
        {
          "name": "Set status paid (admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"paid\"\n}" },
            "url": { "raw": "{{baseUrl}}/orders/:id/status", "host": ["{{baseUrl}}"], "path": ["orders", ":id", "status"], "variable": [{ "key": "id", "value": "{{orderId}}" }] },
            "description": "Admin only: forces `pending → paid`."
          }
        }
      ]
    }
  ]
}
